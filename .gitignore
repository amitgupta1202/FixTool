*.iml
.kotlin
.gradle
**/build/
xcuserdata
!src/**/build/
local.properties
.idea
.DS_Store
captures
.externalNativeBuild
.cxx
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
node_modules/
!store

# Code Quality & Coverage Reports
**/reports/
*.exec
*.log
.jacoco/
detekt-report.html
detekt-report.xml
detekt-report.txt
detekt-report.sarif
detekt-report.md

# Claude Code local settings
.claude/settings.local.json

# SSL Certificates and Keystores (sensitive)
*.jks
*.p12
*.pfx
*.crt
*.cer
*.pem
*.key

# User configuration files (may contain credentials)
**/connection_profiles.json
**/app_settings.json
**/saved_messages.json

# ...but not the bundled example workspaces, which are source rather than anybody's
# configuration. The patterns above are written to catch a file wherever it turns up, and an
# example ships exactly those filenames: without this the manifest names two files the build
# does not have, and opening the example fails on every clean checkout. They carry no
# credentials, which ExampleWorkspacesTest asserts of every file the manifest names.
!composeApp/src/jvmMain/resources/examples/**
