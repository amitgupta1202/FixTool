{
    "schema": 1,
    "name": "equity-rest-and-cancel",
    "label": "Equity rest and cancel",
    "seed": {
        "run": "${uuid:4}"
    },
    "storeAndLog": {
        "store": "MEMORY",
        "log": "NONE"
    },
    "onFailure": "STOP",
    "phases": [
        {
            "label": "Rest",
            "template": "EQTY Load NewOrderSingle",
            "profile": "Equity Load Client",
            "match": {
                "requestTag": 11,
                "replyTag": 11,
                "replyType": "8"
            },
            "shape": {
                "kind": "burst",
                "count": 2000
            },
            "settleMs": 30000
        },
        {
            "label": "Cancel",
            "template": "EQTY Load Cancel",
            "profile": "Equity Load Client",
            "match": {
                "requestTag": 11,
                "replyTag": 11,
                "replyType": "8"
            },
            "shape": {
                "kind": "burst",
                "count": 2000
            },
            "settleMs": 30000
        },
        {
            "label": "Publish",
            "template": "EQTY Load MarketDataRequest",
            "profile": "Equity Load Client",
            "match": {
                "requestTag": 262,
                "replyTag": 262,
                "replyType": "W"
            },
            "shape": {
                "kind": "burst",
                "count": 2000
            },
            "settleMs": 30000
        }
    ]
}
