{
    "schema": 2,
    "name": "fi-rfq-round-trip",
    "label": "FI RFQ round trip — every dealer online quotes each request, then the first offer is lifted",
    "seed": {
        "run": "${uuid:4}"
    },
    "storeAndLog": {
        "store": "MEMORY",
        "log": "NONE"
    },
    "onFailure": "STOP",
    "phases": [
        {
            "label": "Request",
            "template": "FI RFQ Load QuoteRequest",
            "profile": "Buy Side Load Client",
            "listen": [
                "Dealer Load Client"
            ],
            "match": {
                "requestTag": 131,
                "replyTag": 131,
                "replyType": "S"
            },
            "shape": {
                "kind": "burst",
                "count": 1000
            },
            "settleMs": 30000,
            "capture": {
                "quoteId": 117,
                "offer": 133
            }
        },
        {
            "label": "Lift",
            "template": "FI RFQ Load Lift",
            "profile": "Buy Side Load Client",
            "listen": [
                "Dealer Load Client"
            ],
            "match": {
                "requestTag": 11,
                "replyTag": 11,
                "replyType": "8"
            },
            "shape": {
                "kind": "burst",
                "count": 1000
            },
            "settleMs": 30000
        }
    ]
}