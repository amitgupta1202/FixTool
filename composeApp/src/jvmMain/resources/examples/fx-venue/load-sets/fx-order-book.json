{
    "schema": 1,
    "name": "fx-order-book",
    "label": "FX order book",
    "seed": {
        "run": "${uuid:4}"
    },
    "storeAndLog": {
        "store": "MEMORY",
        "log": "NONE"
    },
    "onFailure": "STOP",
    "phases": [
        {
            "label": "Order",
            "template": "FX Load NewOrderSingle",
            "profile": "FX Load Client",
            "match": {
                "requestTag": 11,
                "replyTag": 11,
                "replyType": "8"
            },
            "shape": {
                "kind": "burst",
                "count": 250
            },
            "settleMs": 60000,
            "capture": {
                "orderId": 37
            }
        },
        {
            "label": "Unknown",
            "template": "FX Load Cancel Unknown",
            "profile": "FX Load Client",
            "match": {
                "requestTag": 11,
                "replyTag": 11,
                "replyType": "9"
            },
            "shape": {
                "kind": "burst",
                "count": 2000
            },
            "settleMs": 60000
        },
        {
            "label": "Status",
            "template": "FX Load OrderStatusRequest",
            "profile": "FX Load Client",
            "match": {
                "requestTag": 11,
                "replyTag": 11,
                "replyType": "8"
            },
            "shape": {
                "kind": "burst",
                "count": 250
            },
            "settleMs": 30000
        }
    ]
}
