<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Define the log directory in user's home .fixtool folder -->
    <property name="LOG_DIR" value="${user.home}/.fixtool/logs"/>
    <property name="LOG_FILE" value="fixtool"/>

    <!-- Console appender for development -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Rolling file appender for application logs -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${LOG_FILE}.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>

        <!-- Rolling policy: daily rotation and size-based -->
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <!-- Daily rollover -->
            <fileNamePattern>${LOG_DIR}/${LOG_FILE}.%d{yyyy-MM-dd}.%i.log</fileNamePattern>

            <!-- Each file should be at most 10MB -->
            <maxFileSize>10MB</maxFileSize>

            <!-- Keep 30 days worth of history -->
            <maxHistory>30</maxHistory>

            <!-- Total size of all archive files, if total size > 1GB, oldest archives deleted -->
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Separate appender for errors only -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/${LOG_FILE}-errors.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n%ex{full}</pattern>
        </encoder>

        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_DIR}/${LOG_FILE}-errors.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>90</maxHistory>  <!-- Keep error logs longer -->
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
    </appender>

    <!-- Logger for QuickFIX/J - can be set to INFO to reduce noise -->
    <logger name="quickfix" level="INFO"/>

    <!--
      Logger for our application.

      INFO, not DEBUG, and the difference is a throughput setting rather than a preference. The
      per-message lines in QuickFixService (Sending / Received / toApp / fromApp) run inside the
      QuickFIX/J callback, and the call returns only once every appender below has written the line.
      Measured at DEBUG against the three synchronous appenders here, that is ~9.7us and ~3.4KB of
      garbage PER MESSAGE; with the lines disabled it is ~35ns and no allocation at all — see
      LoggingCostBenchmarkTest, which pins both numbers.

      Nothing is lost by turning them off by default: QuickFIX/J already writes a full per-session
      message log of its own through FileLogFactory (FixConnectionManager), so these lines were a
      second copy of an audit trail that already exists. Set this back to DEBUG to get them, plus the
      rest of the module's debug detail, when actually debugging a session.
    -->
    <logger name="com.knapsack.fixtool" level="INFO"/>

    <!-- Root logger configuration -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
        <appender-ref ref="ERROR_FILE"/>
    </root>
</configuration>
